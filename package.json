{
  "name": "dddfe",
  "version": "0.0.0",
  "private": true,
  "description": "DDD frontend scaffolding with AI agent support (Lauren Tan's approach)",
  "scripts": {
    "test": "pnpm --filter create-dddfe test",
    "verify": "./scripts/verify.sh",
    "verify:arch": "tsx scripts/tools/architecture-scanner.ts",
    "verify:bundle": "tsx scripts/tools/measure-bundle.ts",
    "create": "pnpm --filter create-dddfe exec create-dddfe",
    "lint": "pnpm --dir templates/demo lint",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "frontend",
    "react",
    "xstate",
    "ai-agent",
    "lauren-tan",
    "verification"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "ts-morph": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  }
}
