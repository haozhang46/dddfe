{
  "name": "dddfe",
  "version": "0.0.0",
  "private": true,
  "description": "DDD frontend scaffolding with AI agent support (Lauren Tan's approach)",
  "scripts": {
    "test": "NX_DAEMON=false nx run-many -t test",
    "affected:test": "NX_DAEMON=false nx affected:test",
    "affected:graph": "NX_DAEMON=false node scripts/check-nx-affected.mjs",
    "verify": "./scripts/verify.sh",
    "verify:arch": "tsx scripts/tools/architecture-scanner.ts",
    "verify:bundle": "tsx scripts/tools/measure-bundle.ts",
    "verify:runtime": "tsx scripts/tools/runtime-inspector.ts",
    "verify:runtime:lighthouse": "tsx scripts/tools/runtime-inspector.ts --lighthouse",
    "create": "pnpm --filter create-dddfe exec create-dddfe",
    "lint": "pnpm --dir templates/demo lint",
    "fmt": "pnpm --dir templates/demo fmt",
    "fmt:check": "pnpm --dir templates/demo fmt:check",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:check": "skills check",
    "skills:update": "skills update -p -y",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true; node scripts/install-skills.mjs"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "frontend",
    "react",
    "xstate",
    "ai-agent",
    "lauren-tan",
    "verification"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.2.1",
    "nx": "^24.0.6",
    "skills": "^1.9.0",
    "ts-morph": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=9.0.0"
  }
}
