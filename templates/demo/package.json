{
  "name": "demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node oxlint/check-css-bem.js",
    "lint:css": "node oxlint/check-css-bem.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify": "./scripts/verify.sh",
    "preview": "vite preview",
    "test": "NX_DAEMON=false nx run-many -t test",
    "test:watch": "vitest",
    "affected:test": "NX_DAEMON=false nx affected:test",
    "affected:graph": "NX_DAEMON=false node scripts/check-nx-affected.mjs",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "immer": "^11.1.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.6",
    "react-router": "^8.4.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "nx": "^24.0.6",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
