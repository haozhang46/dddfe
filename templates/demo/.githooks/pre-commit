#!/bin/sh
# Lint, format, and the Nx affected graph before commit.
set -eu

root=$(git rev-parse --show-toplevel)

if [ ! -f "$root/node_modules/oxlint/package.json" ] || [ ! -f "$root/node_modules/oxfmt/package.json" ] || [ ! -f "$root/node_modules/nx/package.json" ]; then
  echo "pre-commit: dependencies missing. Run: pnpm install" >&2
  exit 1
fi

cd "$root"
echo "pre-commit: pnpm lint"
pnpm lint
echo "pre-commit: pnpm fmt:check"
pnpm fmt:check
echo "pre-commit: pnpm affected:graph"
pnpm affected:graph
